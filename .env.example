# ==========================================
# BASE DE DATOS — Aiven PostgreSQL
# ==========================================
# Cadena de conexión completa que te da Aiven (Service URI), incluye sslmode=require
# Ejemplo: postgres://usuario:password@host:puerto/defaultdb?sslmode=require
DATABASE_URL=

# ==========================================
# AUTENTICACIÓN — NextAuth
# ==========================================
# Genera un valor aleatorio con: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ==========================================
# ALMACENAMIENTO DE DOCUMENTOS — Cloudflare R2
# ==========================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cbs-expedientes
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_HOSTNAME=

# ==========================================
# APP
# ==========================================
NEXT_PUBLIC_APP_NAME="CBS Digital"
